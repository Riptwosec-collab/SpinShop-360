# Demo mode: no external credentials are required. Never commit real secrets.
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=th
NEXT_TELEMETRY_DISABLED=1

# Required for real mode (HTTPS APP_URL in production).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key is supported if publishable key is absent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Choose one gateway. Stripe takes precedence if both are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
OMISE_SECRET_KEY=
NEXT_PUBLIC_OMISE_PUBLIC_KEY=

# Optional real order-confirmation email; verify the sender with Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional salt for hashed submission rate-limit keys (otherwise server key is used).
SUBMISSION_RATE_LIMIT_SALT=

# Optional monitoring. Empty DSNs disable event delivery.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
