# Application
NEXT_PUBLIC_APP_NAME="SpinShop 360"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="THB"
NEXT_PUBLIC_DEFAULT_LOCALE="th"
NEXT_PUBLIC_USE_MOCK_DATA="true"

# Supabase — required when NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-side signing. Generate at least 32 random bytes.
# Example: openssl rand -base64 48
CHECKOUT_SIGNING_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Omise / Opn Payments
OMISE_SECRET_KEY=""
NEXT_PUBLIC_OMISE_PUBLIC_KEY=""

# Never enable mock payment on a public production store.
ALLOW_MOCK_PAYMENTS="false"

# Email / Contact
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SpinShop 360 <orders@example.com>"
CONTACT_TO_EMAIL="support@example.com"

# Scheduled cleanup on Vercel
CRON_SECRET=""

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Error monitoring
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
